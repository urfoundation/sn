+//go:build linux
+
+package main
+
+// Fresh provisional startup uses real generation, proof and journal readers.
+// The test process owns the synthetic supervisor identity; nothing is signaled.
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/base64"
+	"encoding/hex"
