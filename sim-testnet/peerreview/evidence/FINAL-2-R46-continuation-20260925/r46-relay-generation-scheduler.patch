+//go:build linux || darwin
+
+// Independent signed generations retain separate discovery cursors. Real
+// publication reads stop at the read-only admission gate, before any spend.
+package main
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/sha256"
+	"encoding/json"
